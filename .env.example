# PLUMB environment. Copy to .env and fill in. Never commit .env.
#
# Nothing here is read at import time. An absent variable makes the real backend
# report itself unavailable with a named reason; it never degrades silently into
# the synthetic fixture.

# ---------------------------------------------------------------------------
# Baseten credentials and routing (plumb/platform.py)
# ---------------------------------------------------------------------------

# Required. Account API key. Sent as "Authorization: Bearer <key>"; it is held in
# a repr-suppressed field and is never logged or printed.
BASETEN_API_KEY=

# Required. The Chain entrypoint async URL, available after the first
# `truss chains push`. The shape is validated strictly (plumb/platform.py):
#   https://chain-<id>.api.baseten.co/production/async_run_remote
#   https://chain-<id>.api.baseten.co/development/async_run_remote
#   https://chain-<id>.api.baseten.co/environments/<name>/async_run_remote
#   https://chain-<id>.api.baseten.co/deployment/<id>/async_run_remote
# HTTPS only, port 443, no credentials/query/fragment.
# NOTE: /async_predict is a MODEL route and is deliberately rejected here. Chains
# use /async_run_remote.
BASETEN_CHAIN_ASYNC_URL=

# Optional but required for result delivery. Without it, callback authentication
# is unavailable and every episode has to be settled by the reconciler.
# Used to verify "X-BASETEN-SIGNATURE: v1=<hmac-sha256>" over the raw request body.
BASETEN_WEBHOOK_SECRET=

# Optional. Defaults to https://api.baseten.co/v1 and is validated to that host.
BASETEN_MANAGEMENT_BASE_URL=https://api.baseten.co/v1

# ---------------------------------------------------------------------------
# PLUMB control plane
# ---------------------------------------------------------------------------

# Required for the real backend. The publicly reachable URL Baseten posts results
# to. Must end in /api/callbacks/<run_id>-compatible path served by this app.
PLUMB_WEBHOOK_ENDPOINT=

# Where mutable run data lives. Gitignored.
PLUMB_DATA_DIR=data

# Where the spec section 8 results/ tree is written. Defaults to the repo root.
PLUMB_RESULTS_DIR=.

# Engine worker pool size for the local control plane.
PLUMB_MAX_WORKERS=8

# ---------------------------------------------------------------------------
# Operating point
# ---------------------------------------------------------------------------
# These must match the setting the cost sweep actually confirmed on a disjoint
# panel. Leaving PLUMB_OPERATING_POINT as "unconfirmed" is honest and is what the
# console will display; do not invent an identifier here.

PLUMB_OPERATING_POINT=unconfirmed
PLUMB_RESOLUTION=256
PLUMB_DENOISE_STEPS=30

# Action rows per forward-dynamics request. Gate A must certify that the
# deployment actually supports this length; 16 is the only length NVIDIA ships an
# example for, and the "multiple of four" rule is NOT established by the
# reviewed source. Note 70 mod 4 == 2, so the 70-tick drawer tasks need either a
# certified non-multiple-of-4 length or a terminal-padding certificate.
PLUMB_ACTION_CHUNK=16

# In-container micro-batch size on the world model. This is the load-bearing knob
# for the 60-second burst target: packing B episodes into one diffusion forward
# divides GPU-seconds by roughly B. Measure it in Gate A; do not assume it.
PLUMB_BATCH_SIZE=1

# Feedback and parity labels carried on every episode record. Leave both
# "unqualified" until Gate B and Gate C actually pass. Setting them by hand does
# not qualify anything -- plumb.gates.QualificationValidator decides -- but a
# wrong value here mislabels the persisted records.
#   feedback_mode: unqualified | native_feedback | forecast_state | chunked_prefix_approximation
PLUMB_FEEDBACK_MODE=unqualified
#   parity_status: unqualified | matched_provenance | matched_distribution_with_limitations
PLUMB_PARITY_STATUS=unqualified

# ---------------------------------------------------------------------------
# Chain deployment knobs (read by deploy/baseten/chain.py at push time)
# ---------------------------------------------------------------------------

# Hugging Face token for gated/large asset pulls inside the Chainlet images.
HF_TOKEN=

# Max replicas per bottleneck Chainlet. Baseten's default is 1. The 1,500-episode
# burst hypothesis is ~100, and raising the account cap is an external dependency.
PLUMB_MAX_REPLICA=100

# World-model micro-batching window in milliseconds.
PLUMB_BATCH_WINDOW_MS=15
